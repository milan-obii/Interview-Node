---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-white rounded-lg p-6 shadow-sm text-center">
    <div class="w-14 h-14 bg-[#EEF1FF] rounded-2xl flex items-center justify-center mx-auto mb-4">
      <img src={icon} alt="Selective" class="w-8 h-8">
    </div>
    <h3 class="text-xl font-semibold text-primary mb-3">{title}</h3>
    <p class="text-gray-600 text-sm">
      {description}
    </p>
  </div>
