---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="bg-white p-6 rounded-xl hover:shadow-lg transition-shadow duration-300 shadow-sm">
    <div class="w-12 h-12 bg-[#EEF1FF] rounded-lg flex items-center justify-center mb-4">
      <img src={icon} alt="Coaching Icon" class="w-6 h-6">
    </div>
    <h3 class="text-xl font-semibold text-primary mb-3">{title}</h3>
    <p class="text-gray-600">
      {description}
    </p>
  </div>
