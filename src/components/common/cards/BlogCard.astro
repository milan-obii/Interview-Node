---
import { Image } from "astro:assets";

const { image, title, date, author } = Astro.props;
---
<div class=" rounded-xl overflow-hidden  h-full ">
    <div class="aspect-w-16 aspect-h-9 rounded-3xl border border-gray-200">
      <img
        src={image}
        alt="Team brainstorming session"
        class="w-full h-56 object-cover rounded-xl"
      />
    </div>
    <div class="p-4 w-[98%] z-20 relative  -mt-14 mx-auto bg-white border border-gray-200 rounded-2xl">
      <h3 class="text-xl font-bold text-gray-900 ">
        {title}
      </h3>
      <div class="flex items-center justify-between mt-4">
        <div class="flex items-center gap-2 text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>{date}</span>
        </div>
        <div class="flex items-center gap-2 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>{author}</span>
        </div>
      </div>
    </div>
  </div>
