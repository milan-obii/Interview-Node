---
const { title, description, image } = Astro.props;
---
<div class="">
    <img
      src={image}
      alt="Machine Learning Engineer"
      class=" h-56 w-full -mb-3 rounded-t-xl"
    />
    <div class="p-6 pt-5 w-[95%] mx-auto text-black bg-white rounded-b-xl">
      <h3 class="text-xl font-semibold  mb-1 ">{title}</h3>
      <p class="text-gray-700 text-sm">
        {description}
      </p>
    </div>
  </div>
