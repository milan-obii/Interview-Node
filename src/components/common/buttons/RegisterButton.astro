---
const { textColour = 'text-white', backgroundColour = 'bg-primary',svgBackgroundColour = 'bg-white',svgTextColour = 'text-[#0D1942]' } = Astro.props;
---
<a href="#" class={`${backgroundColour} w-fit ${textColour} pl-2 pr-4 py-1.5 group rounded-full flex items-center gap-2 hover:bg-blue-800 transition-colors`}>
    <div class={`${svgBackgroundColour} ${svgTextColour} rounded-full p-2 group-hover:translate-x-1 duration-300`}>

        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
    </div>
  <span>Register for our Free Workshop</span>
</a>
