---
// Accepts props for the target date and storage key
const {
  targetDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000), // Default: 7 days from now
  daysLabel = "Days",
  hoursLabel = "Hrs",
  minsLabel = "Mins",
  secsLabel = "Secs",
  // We'll use a fixed timer ID for the universal timer
  timerId = "universal-workshop-timer",
  // Optional initial values if coming from database
  initialDays,
  initialHours,
  initialMinutes,
  initialSeconds,
  bgColor = "bg-white",
  textColor = "text-primary",
  labelColor = "text-gray-500",
  autoReset = true, // New prop to control auto-reset behavior
  resetDays = 7 // Number of days to reset to
} = Astro.props;

// Generate a unique DOM ID based on the timer ID to avoid conflicts with multiple instances
const domIdPrefix = `countdown-${timerId}-`;
---

<div class={`countdown-container ${bgColor} rounded-2xl p-4 shadow-sm`}>
  <div class="grid grid-cols-7  text-center">
    <!-- Days -->
    <div class="  ">
      <div class={`text-3xl font-bold ${textColor}`} id={`${domIdPrefix}days`}>00</div>
      <div class={`text-sm ${labelColor}`}>{daysLabel}</div>
    </div>
    <div class={`text-3xl  font-bold ${textColor}`}>
        :
    </div>
    <!-- Hours -->
    <div class=" ">
      <div class={`text-3xl font-bold ${textColor}`} id={`${domIdPrefix}hours`}>00</div>
      <div class={`text-sm ${labelColor}`}>{hoursLabel}</div>
    </div>
    <div class={`text-3xl  font-bold ${textColor}`}>
        :
    </div>
    <!-- Minutes -->
    <div class=" ">
      <div class={`text-3xl font-bold ${textColor}`} id={`${domIdPrefix}minutes`}>00</div>
      <div class={`text-sm ${labelColor}`}>{minsLabel}</div>
    </div>
    <div class={`text-3xl  font-bold ${textColor}`}>
        :
    </div>
    <!-- Seconds -->
    <div class=" ">
      <div class={`text-3xl font-bold ${textColor}`} id={`${domIdPrefix}seconds`}>00</div>
      <div class={`text-sm ${labelColor}`}>{secsLabel}</div>
    </div>
  </div>
</div>

<script is:inline define:vars={{
  targetDateStr: targetDate.toISOString(),
  timerId,
  domIdPrefix,
  initialValues: {
    days: initialDays,
    hours: initialHours,
    minutes: initialMinutes,
    seconds: initialSeconds
  },
  autoReset,
  resetDays
}}>
  document.addEventListener('DOMContentLoaded', function() {
    // Use a consistent storage key for all timers
    const GLOBAL_TIMER_KEY = 'global-workshop-countdown';

    // Get elements using the unique prefix
    const daysEl = document.getElementById(`${domIdPrefix}days`);
    const hoursEl = document.getElementById(`${domIdPrefix}hours`);
    const minutesEl = document.getElementById(`${domIdPrefix}minutes`);
    const secondsEl = document.getElementById(`${domIdPrefix}seconds`);

    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;

    // Function to retrieve stored countdown data
    function getStoredCountdown() {
      try {
        const stored = localStorage.getItem(GLOBAL_TIMER_KEY);
        if (stored) {
          return JSON.parse(stored);
        }
      } catch (e) {
        console.error("Error retrieving stored countdown:", e);
      }
      return null;
    }

    // Function to store countdown data
    function storeCountdown(endTime) {
      try {
        localStorage.setItem(GLOBAL_TIMER_KEY, JSON.stringify({
          endTime: endTime
        }));
      } catch (e) {
        console.error("Error storing countdown:", e);
      }
    }

    // Function to create a new countdown
    function createNewCountdown() {
      const newEndTime = Date.now() + (resetDays * 24 * 60 * 60 * 1000);
      storeCountdown(newEndTime);
      return newEndTime;
    }

    // Get or initialize the countdown end time
    let endTime;
    const storedData = getStoredCountdown();

    if (storedData && storedData.endTime) {
      // If there's a stored end time but it's in the past, create a new one
      if (storedData.endTime <= Date.now()) {
        endTime = createNewCountdown();
      } else {
        endTime = storedData.endTime;
      }
    } else {
      // If there's no stored end time, create a new one
      endTime = createNewCountdown();
    }

    function updateCountdown() {
      const now = Date.now();
      const distance = endTime - now;

      // If countdown is finished
      if (distance < 0) {
        if (autoReset) {
          // Reset to a new countdown
          endTime = createNewCountdown();
        } else {
          // If no auto-reset, just show zeros
          clearInterval(countdownInterval);
          daysEl.textContent = '00';
          hoursEl.textContent = '00';
          minutesEl.textContent = '00';
          secondsEl.textContent = '00';

          // Clear the stored data when finished if not auto-resetting
          localStorage.removeItem(GLOBAL_TIMER_KEY);
          return;
        }
      }

      // Calculate time remaining
      const updatedDistance = endTime - Date.now();

      const days = Math.max(0, Math.floor(updatedDistance / (1000 * 60 * 60 * 24)));
      const hours = Math.max(0, Math.floor((updatedDistance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
      const minutes = Math.max(0, Math.floor((updatedDistance % (1000 * 60 * 60)) / (1000 * 60)));
      const seconds = Math.max(0, Math.floor((updatedDistance % (1000 * 60)) / 1000));

      // Update the display
      daysEl.textContent = days.toString().padStart(2, '0');
      hoursEl.textContent = hours.toString().padStart(2, '0');
      minutesEl.textContent = minutes.toString().padStart(2, '0');
      secondsEl.textContent = seconds.toString().padStart(2, '0');
    }

    // Run immediately and then every second
    updateCountdown();
    const countdownInterval = setInterval(updateCountdown, 1000);

    // Ensure timers stay in sync by listening for storage events from other tabs/pages
    window.addEventListener('storage', function(e) {
      if (e.key === GLOBAL_TIMER_KEY) {
        try {
          const newData = JSON.parse(e.newValue);
          if (newData && newData.endTime) {
            endTime = newData.endTime;
            updateCountdown();
          }
        } catch(err) {
          console.error("Error processing storage event:", err);
        }
      }
    });
  });
</script>

<style>
  .countdown-container {
    max-width: 100%;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.8; }
    100% { opacity: 1; }
  }

  #countdown-seconds {
    animation: pulse 1s infinite;
  }
</style>
