---
import Layout from '../layouts/Layout.astro';
import CompanyCarousel from '../components/common/carousel/CompanyCarousel.astro';
import CountdownTimer from '../components/common/timer/CountdownTimer.astro';
import RegisterButton from '../components/common/buttons/RegisterButton.astro';
import WelcomePageFeatureCard from '../components/common/cards/WelcomePageFeatureCard.astro';
import KnowMoreButton from '../components/common/buttons/KnowMoreButton.astro';
import WelcomePageOurCoursesCard from '../components/common/cards/WelcomePageOurCoursesCard.astro';
import WelcomeCareerPathCarouselCard from '../components/common/cards/WelcomeCareerPathCarouselCard.astro';
import BlogCarousel from '../components/common/carousel/BlogCarousel.astro';

// Fetch homepage data from API
const response = await fetch('http://interview-node.vadakurry.com/wp-json/interview-node/v1/home-sections');
const apiData = await response.json();
const { data } = apiData;

// Log the data for debugging
console.log('API Data:', data);
