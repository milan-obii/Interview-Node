            <!-- Section header -->
            <div class="text-center mb-12 md:mb-16 max-w-3xl mx-auto">
              <h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">Our Courses</h2>
              <p class="text-gray-700">
                With Interview Node, you don't just prepare—you master the art of ML.
                Transform your career trajectory and land the job you've always wanted.
              </p>
            </div>

            <!-- Course cards container -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10">

              <!-- Program 1 -->
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <!-- Course image -->
                <img
                src="/src/assets/homepage/typing-1.png"
                alt="Person taking advanced ML course"
                class="w-full h-56"
              />


                <!-- Course content -->
                <div class="p-6">
                  <h3 class="text-2xl font-semibold text-primary mb-4">Program #1</h3>

                  <!-- Guaranteed badge -->
                  <div class="bg-[#42965C] text-white text-lg px-4 py-4 rounded-lg flex items-center mb-6">
                    <div class="mr-2">
                     <img src="/src/assets/homepage/badge.svg" alt="Guaranteed Placement" class="size-8" />
                    </div>
                    <span class="font-medium">Guaranteed Placement</span>
                  </div>

                  <!-- Features list -->
                  <div class="space-y-3 mb-6">
                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">Duration:</span>
                      <span class="font-medium">6 Months</span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">15 mentor sessions/mock interviews</span>
                      <span class="font-medium"></span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">100% Placement</span>
                      <span class="font-medium"></span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">Money Back Guarantee</span>
                      <span class="font-medium"></span>
                    </div>

                    <div class="flex justify-between py-2 ">
                      <span class="text-gray-600">100% Personalized curriculum</span>
                      <span class="font-medium"></span>
                    </div>
                  </div>

                  <!-- Know more button -->
                  <div>
                    <KnowMoreButton href="/courses/program-1" />
                  </div>
                </div>
              </div>

              <!-- Program 2 -->
              <div class="bg-white rounded-xl  shadow-sm overflow-hidden">
                <!-- Course image -->

                    <img
                      src="/src/assets/homepage/typing-2.png"
                      alt="Person taking advanced ML course"
                      class="w-full h-56"
                    />


                <!-- Course content -->
                <div class="p-6">
                  <h3 class="text-2xl font-semibold text-primary mb-4">Program #2</h3>

                  <!-- Guaranteed badge -->
                  <div class="bg-[#42965C] text-white text-lg px-4 py-4 rounded-lg flex items-center mb-6">
                    <div class="mr-2">
                     <img src="/src/assets/homepage/badge.svg" alt="Guaranteed Placement" class="size-8" />
                    </div>
                    <span class="font-medium">Guaranteed Placement</span>
                  </div>

                  <!-- Features list -->
                  <div class="space-y-3 mb-6">
                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">Duration:</span>
                      <span class="font-medium">6 Months</span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">15 mentor sessions/mock interviews</span>
                      <span class="font-medium"></span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">100% Placement</span>
                      <span class="font-medium"></span>
                    </div>

                    <div class="flex justify-between py-2 border-b border-gray-100">
                      <span class="text-gray-600">Money Back Guarantee</span>
                      <span class="font-medium"></span>
                    </div>

                    <div class="flex justify-between py-2 ">
                      <span class="text-gray-600">100% Personalized curriculum</span>
                      <span class="font-medium"></span>
                    </div>
                  </div>

                  <!-- Know more button -->
                  <div>
                    <KnowMoreButton href="/courses/program-2" />
                  </div>
                </div>
              </div>
            </div>

            <!-- Why Interview Node section -->
            <div class="mt-24 md:mt-32">
              <h2 class="text-3xl md:text-4xl font-bold text-primary text-center mb-12 md:mb-16">Why Interview Node?</h2>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Feature 1 -->
                <WelcomePageOurCoursesCard title="Selective Focused Cohorts" description="We only accept the most dedicated candidates through a focused entrance test, ensuring every cohort member shares the same drive and ambition." icon="/src/assets/welcome-page-feature-card-icons/5.svg" />

                <!-- Feature 2 -->
                <WelcomePageOurCoursesCard title="Targeted Curriculum" description="Our curriculum, led by FAANG instructors, is laser-focused on ML interview preparation, with no unnecessary distractions or dilution." icon="/src/assets/welcome-page-feature-card-icons/6.svg" />

                <!-- Feature 3 -->
               <WelcomePageOurCoursesCard title="Mock Interviews & Feedback" description="Built-in mock interviews provide ample practice and personalized feedback, so you're fully prepared for the real thing." icon="/src/assets/welcome-page-feature-card-icons/3.svg" />

                <!-- Feature 4 -->
                <WelcomePageOurCoursesCard title="Job Placement Support" description="We partner with top placement companies to match you with the right opportunities, helping you land your dream ML job." icon="/src/assets/welcome-page-feature-card-icons/4.svg" />


              </div>
            </div>
          </section>
        </section>
        <!-- todo:----------------- (4) Careers Paths ----------------- -->
        <section class="px-4 lg:px-10 2xl:px-20 bg-[#0B207C] text-white">
          <section class="py-16 md:py-24 container mx-auto">
            <div class="flex flex-col lg:flex-row gap-12">
              <!-- Left content -->
              <div class="lg:w-1/3">
                <h2 class="text-3xl md:text-4xl font-bold mb-6">Career Paths</h2>
                <p class="text-lg opacity-90 mb-10">
                  At Interview Node, we guide you through the career exploration process, helping you understand different roles, required skill sets, and potential growth trajectories.
                </p>

                <div class="mb-8">
                  <h3 class="text-2xl font-semibold mb-4">Next Workshop in</h3>
                  <CountdownTimer timerId="career-paths-countdown" bgColor="bg-white" textColor="text-primary" labelColor="text-gray-500" />
                </div>

                <div class="mt-8">
                  <RegisterButton textColour="text-primary" backgroundColour="bg-white" svgBackgroundColour="bg-primary" svgTextColour="text-white" />
                </div>
              </div>

              <!-- Right carousel -->
              <div class="lg:w-2/3">
                <div class="career-paths-carousel swiper">
                  <div class="swiper-wrapper">
                    <!-- Slide 1: Machine Learning Engineer -->
                    <div class="swiper-slide">
                     <WelcomeCareerPathCarouselCard title="Machine Learning Engineer" description="ML Engineers are among the highest-paid roles in tech. With the ML market in the US projected to grow at an incredible 24.5% annually through 2030, there's never been a better time to level up your skills and land your dream job." image="/src/assets/homepage/typing-1.png" />
                    </div>

                    <!-- Slide 2: Data Scientist -->
                    <div class="swiper-slide">
                      <WelcomeCareerPathCarouselCard title="Data Scientist" description="Data Engineers are the backbone of modern tech, powering everything from AI to analytics. With demand soaring and companies racing to build scalable data systems, it's one of the fastest-growing and best-paid roles in the US." image="/src/assets/homepage/typing-2.png" />
                    </div>

                    <!-- Slide 3: AI Product Manager -->
                    <div class="swiper-slide">
                      <WelcomeCareerPathCarouselCard title="AI Product Manager" description="AI Product Managers are the bridge between tech and business, driving innovation and shaping the future of AI. With companies like Google, Amazon, and Microsoft leading the charge, it's a role that's in high demand and offers significant growth potential." image="/src/assets/homepage/typing-1.png" />
                    </div>
                  </div>

                  <!-- Pagination dots -->
                  <div class="swiper-pagination"></div>
                </div>
              </div>
            </div>
          </section>
        </section>
        <script is:inline>
          document.addEventListener('DOMContentLoaded', function() {
            const swiper = new Swiper('.career-paths-carousel', {
              slidesPerView: 1,
              spaceBetween: 30,
              loop: true,
              autoplay: {
                delay: 5000,
                disableOnInteraction: false,
              },
              pagination: {
                el: '.swiper-pagination',
                clickable: true,
              },
              breakpoints: {
                // When screen width is >= 768px
                768: {
                  slidesPerView: 1.8,
                  centeredSlides: true,
                },
              }
            });
          });
        </script>
        <style>
          .career-paths-carousel {
            padding-bottom: 50px;
          }

          .swiper-pagination {
            bottom: 0 !important;
          }

          .swiper-pagination-bullet {
            background: rgba(255, 255, 255, 0.5);
          }

          .swiper-pagination-bullet-active {
            background: white;
          }

          /* Add gradient overlay to highlight active slide */
          .swiper-slide-active {
            z-index: 1;
          }

          /* Make sure the slides have same height */
          .swiper-slide {
            height: auto;
          }
        </style>
        <!-- todo: (5) start your journey -->
