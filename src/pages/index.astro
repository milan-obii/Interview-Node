            <!-- ? (1) Left content area -->
            <div class="lg:w-3/5">
              <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-primary leading-tight mb-4">
                AI & ML Upskilling + Interview Preparation + Guaranteed  Placement — All in One Platform
