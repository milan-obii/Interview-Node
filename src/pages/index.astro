              </div>
            </div>
          </div>
          <!-- ! (2) Top firms we help you get hired at -->
          <div class="mt-40">
            <h2 class="text-2xl font-semibold text-center text-primary mb-10">Top firms we help you get hired at</h2>
             <CompanyCarousel/>
          </div>
        </section>
        </section>
        <!-- todo:----------------- (2) Features Section ----------------- -->
        <section class="px-4 lg:px-10 2xl:px-20 bg-gradient-to-b from-[#0B207C1A] to-[#E5EAFF]">
          <section class="py-16 md:py-24 container mx-auto">
            <!-- ! (1) container of timer and cards -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-16 gap-8">
              <!-- ? (1) timer and register button -->
              <div class="max-w-md lg:max-w-xl">
                <!-- (1) Title and description -->
                <div class=" mb-16">
                    <h2 class="text-3xl md:text-4xl font-bold text-primary  mb-6">
                      Unlock Your Dream ML Job with Interview Node
                    </h2>
                    <p class="text-gray-700  md:text-lg max-w-3xl mx-auto">
                      Securing the right opportunity requires more than just technical knowledge. Interview Node is your gateway to career success, helping you navigate the interview process with confidence and precision.
                    </p>
                  </div>
                  <!--  (2) timer and register button -->
                <h3 class="text-2xl font-semibold text-[#414141] mb-4">Next Workshop in</h3>
                <div class="mb-6">
                  <CountdownTimer timerId="features-countdown" bgColor="bg-primary" textColor="text-white" labelColor="text-white" />
                </div>
                <div class="mt-8">
                  <RegisterButton />
                </div>
              </div>
              <!-- ? (2) container of cards -->
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 max-w-3xl 2xl:max-w-4xl">
                <!-- Feature Card 1 -->
                <WelcomePageFeatureCard title="Interactive Live Classes" description="Join live classes led by industry experts and master the insights, strategies, and best practices you need to ace technical interviews." icon="/src/assets/welcome-page-feature-card-icons/1.svg" />

                <!-- Feature Card 2 -->
                <WelcomePageFeatureCard title="Personalized 1-1 Coaching" description="Receive personalized one-on-one coaching to sharpen your skills and make quick adjustments for better outcomes." icon="/src/assets/welcome-page-feature-card-icons/2.svg" />

                <!-- Feature Card 3 -->
                <WelcomePageFeatureCard title="Mock Interviews" description="Tailored mock interviews that mirror real technical interview scenarios, giving you invaluable practice and feedback to excel when it counts." icon="/src/assets/welcome-page-feature-card-icons/3.svg" />

                <!-- Feature Card 4 -->
               <WelcomePageFeatureCard title="Career Transition Guidance" description="Get dedicated placement support from top staffing agencies specializing in machine learning roles so that you can land your dream job." icon="/src/assets/welcome-page-feature-card-icons/4.svg" />
              </div>
            </div>
          </section>
        </section>
        <!-- todo:----------------- (3) Our Courses ----------------- -->

        <section class="px-4 lg:px-10 2xl:px-20 py-16 md:py-24">
