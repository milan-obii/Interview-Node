        <!-- todo:----------------- (4) Careers Paths ----------------- -->
        <section class="px-4 lg:px-10 2xl:px-20 bg-gradient-to-r from-[#0B207C] to-[#637CF4] text-white">
          <section class="py-16 md:py-24 container mx-auto">
