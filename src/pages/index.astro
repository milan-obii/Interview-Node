                  </div>
                </div>
              </div>
              ))}


            </div>

            <!-- Why Interview Node section -->
            <div class="mt-24 md:mt-32">
              <h2 class="text-3xl md:text-4xl font-bold text-primary text-center mb-12 md:mb-16">
                <!-- Why Interview Node? -->
