                      <path d="M53.0383 2.71453C51.0528 4.0201 48.6758 6.01503 47.3414 7.85526L47.8188 3.9172L45.666 0.585938C47.6712 1.65656 50.6817 2.41013 53.0383 2.71453Z" fill="#0B207C" fill-opacity="0.9"/>
                      <path d="M47.0058 1.73795C48.4805 2.307 50.176 2.7416 51.7241 3.0175C50.4529 3.94333 49.1186 5.07618 48.0417 6.2333L48.3151 3.97737L48.3369 3.79777L48.2387 3.64582L47.0058 1.73795Z" stroke="#0B207C" stroke-opacity="0.9"/>
