  },
  {
    id: 3,
    title: "Ace Your Anthropic ML Interview: Top 25 Questions and Expert Tips",
    excerpt: "Preparing for a machine learning (ML) interview at Anthropic? You're in the right place. Anthropic, the AI safety company...",
    author: "Santosh Rout",
    readTime: "09 min read",
    date: "01st March 2025",
    image: "/src/assets/blogs/team-1.png",
    category: "Category 1"
  },
  {
    id: 4,
    title: "Ace Your Anthropic ML Interview: Top 25 Questions and Expert Tips",
    excerpt: "Preparing for a machine learning (ML) interview at Anthropic? You're in the right place. Anthropic, the AI safety company...",
    author: "Santosh Rout",
    readTime: "09 min read",
    date: "01st March 2025",
    image: "/src/assets/blogs/team-2.png",
    category: "Category 2"
  },
  {
